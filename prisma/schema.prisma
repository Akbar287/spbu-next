// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ActivityLog {
  activityLogId String    @id @default(uuid()) @map("activity_log_id")
  memberId      String    @map("member_id")
  namaAktivitas String    @map("nama_aktivitas")
  class         String
  function      String
  input         String
  output        String
  createdAt     DateTime? @map("created_at")
  updatedAt     DateTime? @map("updated_at")
  member        Member    @relation(fields: [memberId], references: [memberId])

  @@map("activity_log")
}

model AreaMember {
  areaMemberId String    @id @default(uuid()) @map("area_member_id")
  memberId     String    @map("member_id")
  provinsi     String
  kabupaten    String
  kecamatan    String
  desa         String
  rw           String
  rt           String
  no           String
  alamat       String
  isPrimary    Boolean   @map("is_primary")
  createdAt    DateTime? @map("created_at")
  updatedAt    DateTime? @map("updated_at")
  member       Member    @relation(fields: [memberId], references: [memberId])

  @@map("area_member")
}

model Aset {
  asetId            String     @id @default(uuid()) @map("aset_id")
  spbuId            String     @map("spbu_id")
  namaAset          String     @map("nama_aset")
  jumlah            Int
  tanggalDigunakan  DateTime   @map("tanggal_digunakan")
  harga             Decimal    @db.Decimal(16, 6)
  penyusutanPerHari Decimal    @map("penyusutan_per_hari") @db.Decimal(16, 2)
  isDigunakan       Boolean    @map("is_digunakan")
  keterangan        String
  createdAt         DateTime?  @map("created_at")
  updatedAt         DateTime?  @map("updated_at")
  spbu              Spbu       @relation(fields: [spbuId], references: [spbuId])
  fileAset          FileAset[]

  @@map("aset")
}

model Bonus {
  bonusId    String   @id @default(uuid()) @map("bonus_id")
  memberId   String   @map("member_id")
  persentase Int
  totalBonus Decimal  @map("total_bonus") @db.Decimal(16, 2)
  tanggal    DateTime
  deksripsi  String?
  member     Member   @relation(fields: [memberId], references: [memberId])

  @@map("bonus")
}

model DetailGaji {
  detailGajiId String     @id @default(uuid()) @map("detail_gaji_id")
  gajiMemberId String     @map("gaji_member_id")
  namaGaji     String     @map("nama_gaji")
  type         String
  total        Decimal    @db.Decimal(16, 6)
  gajiMember   GajiMember @relation(fields: [gajiMemberId], references: [gajiMemberId])

  @@map("detail_gaji")
}

model DetailPenjualan {
  detailPenjualanId String     @id @default(uuid()) @map("detail_penjualan_id")
  penjualanId       String     @map("penjualan_id")
  standMeterId      String     @map("stand_meter_id")
  hargaId           String     @map("harga_id")
  liter             Decimal    @db.Decimal(16, 6)
  totalDetailJual   Decimal    @map("total_detail_jual") @db.Decimal(16, 6)
  createdAt         DateTime?  @map("created_at")
  updatedAt         DateTime?  @map("updated_at")
  isConfirmed       Boolean    @default(false) @map("is_confirmed")
  Penjualan         Penjualan  @relation(fields: [penjualanId], references: [penjualanId])
  StandMeter        StandMeter @relation(fields: [standMeterId], references: [standMeterId])
  Harga             Harga      @relation(fields: [hargaId], references: [hargaId])

  @@map("detail_penjualan")
}

model DetailProduk {
  detailProdukId String @id @default(uuid()) @map("detail_produk_id")
  produkId       String @map("produk_id")
  namaJenis      String @map("nama_jenis")
  oktan          Int
  Produk         Produk @relation(fields: [produkId], references: [produkId])

  @@map("detail_produk")
}

model DetailRencanaPembelian {
  detailRencanaPembelianId  String                      @id @default(uuid()) @map("detail_rencana_pembelian_id")
  rencanaPembelianId        String                      @map("rencana_pembelian_id")
  produkId                  String                      @map("produk_id")
  jumlah                    Decimal                     @db.Decimal(16, 6)
  satuanJumlah              String                      @map("satuan_jumlah")
  rit                       Decimal                     @db.Decimal(6, 2)
  harga                     Decimal                     @db.Decimal(16, 6)
  totalHarga                Decimal                     @map("total_harga") @db.Decimal(16, 6)
  isConfirmation            Boolean                     @map("is_confirmation")
  createdAt                 DateTime?                   @map("created_at")
  updatedAt                 DateTime?                   @map("updated_at")
  ms2                       Boolean
  delivery                  Boolean
  kodeDetail                String                      @unique @map("kode_detail")
  RencanaPembelian          RencanaPembelian            @relation(fields: [rencanaPembelianId], references: [rencanaPembelianId])
  Produk                    Produk                      @relation(fields: [produkId], references: [produkId])
  DetailRencanaPembelianMs2 DetailRencanaPembelianMs2[]
  DetailRencanaFile         DetailRencanaFile[]

  @@map("detail_rencana_pembelian")
}

model DetailRencanaPembelianMs2 {
  detailRencanaPembelianMs2Id String                 @id @default(uuid()) @map("detail_rencana_pembelian_ms2_id")
  ms2Id                       String                 @map("ms2_id")
  detailRencanaPembelianId    String                 @map("detail_rencana_pembelian_id")
  isDelivery                  Boolean                @map("is_delivery")
  createdAt                   DateTime?              @map("created_at")
  updatedAt                   DateTime?              @map("updated_at")
  jamKerjaId                  String?                @map("jam_kerja_id")
  Ms2                         Ms2                    @relation(fields: [ms2Id], references: [ms2Id])
  DetailRencanaPembelian      DetailRencanaPembelian @relation(fields: [detailRencanaPembelianId], references: [detailRencanaPembelianId])
  JamKerja                    JamKerja?              @relation(fields: [jamKerjaId], references: [jamKerjaId])

  @@map("detail_rencana_pembelian_ms2")
}

model DetailTera {
  detailTeraId  String      @id @default(uuid()) @map("detail_tera_id")
  dokumenStokId String      @map("dokumen_stok_id")
  teraId        String      @map("tera_id")
  quantity      Decimal     @db.Decimal(16, 6)
  harga         Decimal     @db.Decimal(16, 6)
  keterangan    String
  createdAt     DateTime?   @map("created_at")
  updatedAt     DateTime?   @map("updated_at")
  DokumenStok   DokumenStok @relation(fields: [dokumenStokId], references: [dokumenStokId])
  Tera          Tera        @relation(fields: [teraId], references: [teraId])

  @@map("detail_tera")
}

model Devices {
  devicesId     String      @id @default(uuid()) @map("devices_id")
  penjadwalanId String      @map("penjadwalan_id")
  ipv4          String
  typeDevices   String      @map("type_devices")
  modelDevices  String      @map("model_devices")
  os            String
  versiOs       String      @map("versi_os")
  browser       String
  versiBrowser  String      @map("versi_browser")
  createdAt     DateTime?   @map("created_at")
  updatedAt     DateTime?   @map("updated_at")
  Penjadwalan   Penjadwalan @relation(fields: [penjadwalanId], references: [penjadwalanId])

  @@map("devices")
}

model Dispenser {
  dispenserId   String   @id @default(uuid()) @map("dispenser_id")
  payungId      String   @map("payung_id")
  namaDispenser String   @map("nama_dispenser")
  keterangan    String?
  isAktif       Boolean  @map("is_aktif")
  Payung        Payung   @relation(fields: [payungId], references: [payungId])
  Nozzle        Nozzle[]

  @@map("dispenser")
}

model Divisi {
  divisiId   String    @id @default(uuid()) @map("divisi_id")
  spbuId     String    @map("spbu_id")
  namaDivisi String    @map("nama_divisi")
  keterangan String?
  isAktif    Boolean   @map("is_aktif")
  createdAt  DateTime? @map("created_at")
  updatedAt  DateTime? @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  Spbu       Spbu      @relation(fields: [spbuId], references: [spbuId])
  Level      Level[]

  @@map("divisi")
}

model DokumenStok {
  dokumenStokId        String                      @id @default(uuid()) @map("dokumen_stok_id")
  stokInventoryId      String                      @map("stok_inventory_id")
  memberId             String                      @map("member_id")
  dombakId             String                      @map("dombak_id")
  jamKerjaId           String                      @map("jam_kerja_id")
  typeDokumenStokId    String                      @map("type_dokumen_stok_id")
  tanggal              DateTime
  stokAwal             Decimal                     @map("stok_awal") @db.Decimal(16, 6)
  stokAkhir            Decimal                     @map("stok_akhir") @db.Decimal(16, 6)
  isConfirmation       Boolean                     @map("is_confirmation")
  createdAt            DateTime?                   @map("created_at")
  updatedAt            DateTime?                   @map("updated_at")
  StokInventory        StokInventory               @relation(fields: [stokInventoryId], references: [stokInventoryId])
  Member               Member                      @relation(fields: [memberId], references: [memberId])
  Dombak               Dombak                      @relation(fields: [dombakId], references: [dombakId])
  JamKerja             JamKerja                    @relation(fields: [jamKerjaId], references: [jamKerjaId])
  TypeDokumenStok      TypeDokumenStok             @relation(fields: [typeDokumenStokId], references: [typeDokumenStokId])
  DetailTera           DetailTera[]
  FileDokumenStok      FileDokumenStok[]
  Konversi             KonversiDokumenStok[]
  Losses               Losses[]
  Penerimaan           Penerimaan[]
  PenerimaanStokTaking PenerimaanStokTaking[]
  DombakTransfer       DombakTransferDokumenStok[]
  StandMeter           StandMeterDokumenStok[]

  @@map("dokumen_stok")
}

model Dombak {
  dombakId            String                @id @default(uuid()) @map("dombak_id")
  spbuId              String                @map("spbu_id")
  namaDombak          String                @map("nama_dombak")
  keterangan          String?
  isAktif             Boolean               @map("is_aktif")
  Spbu                Spbu                  @relation(fields: [spbuId], references: [spbuId])
  DokumenStok         DokumenStok[]
  Konversi            Konversi[]
  StandMeter          StandMeter[]
  StokInventoryDombak StokInventoryDombak[]
  Payung              DombakPayung[]

  @@map("dombak")
}

model DombakTransfer {
  dombakTransferId String                      @id @default(uuid()) @map("dombak_transfer_id")
  produkId         String                      @map("produk_id")
  jamKerjaId       String                      @map("jam_kerja_id")
  tanggal          DateTime
  isConfirmation   Boolean                     @map("is_confirmation")
  createdAt        DateTime?                   @map("created_at")
  updatedAt        DateTime?                   @map("updated_at")
  Produk           Produk                      @relation(fields: [produkId], references: [produkId])
  JamKerja         JamKerja                    @relation(fields: [jamKerjaId], references: [jamKerjaId])
  DokumenStok      DombakTransferDokumenStok[]

  @@map("dombak_transfer")
}

model Fasilitas {
  fasilitasId      String          @id @default(uuid()) @map("fasilitas_id")
  spbuId           String          @map("spbu_id")
  namaFasilitas    String          @map("nama_fasilitas")
  jumlah           Int
  tanggalDigunakan DateTime        @map("tanggal_digunakan")
  keterangan       String
  createdAt        DateTime?       @map("created_at")
  updatedAt        DateTime?       @map("updated_at")
  Spbu             Spbu            @relation(fields: [spbuId], references: [spbuId])
  FileFasilitas    FileFasilitas[]

  @@map("fasilitas")
}

model FileAset {
  fileAsetId    String   @id @default(uuid()) @map("file_aset_id")
  asetId        String   @map("aset_id")
  namaFile      String   @map("nama_file")
  namaDokumen   String   @map("nama_dokumen")
  tanggalUpload DateTime @map("tanggal_upload")
  createdAt     DateTime @map("created_at")
  updatedAt     DateTime @map("updated_at")
  Aset          Aset     @relation(fields: [asetId], references: [asetId])

  @@map("file_aset")
}

model FileDokumenStok {
  fileDokumenStokId String      @id @default(uuid()) @map("file_dokumen_stok_id")
  dokumenStokId     String      @map("dokumen_stok_id")
  namaFile          String      @map("nama_file")
  namaDokumen       String      @map("nama_dokumen")
  tanggalUpload     DateTime    @map("tanggal_upload")
  createdAt         DateTime    @map("created_at")
  updatedAt         DateTime    @map("updated_at")
  DokumenStok       DokumenStok @relation(fields: [dokumenStokId], references: [dokumenStokId])

  @@map("file_dokumen_stok")
}

model FileFasilitas {
  fileFasilitasId String    @id @default(uuid()) @map("file_fasilitas_id")
  fasilitasId     String    @map("fasilitas_id")
  namaFile        String    @map("nama_file")
  namaDokumen     String    @map("nama_dokumen")
  tanggalUpload   DateTime  @map("tanggal_upload")
  createdAt       DateTime  @map("created_at")
  updatedAt       DateTime  @map("updated_at")
  Fasilitas       Fasilitas @relation(fields: [fasilitasId], references: [fasilitasId])

  @@map("file_fasilitas")
}

model FileLampiranLo {
  fileLampiranLoId String   @id @default(uuid()) @map("file_lampiran_lo_id")
  fileLoId         String   @map("file_lo_id")
  namaFile         String   @map("nama_file")
  namaDokumen      String   @map("nama_dokumen")
  tanggalUpload    DateTime @map("tanggal_upload")
  FileLo           FileLo   @relation(fields: [fileLoId], references: [fileLoId])

  @@map("file_lampiran_lo")
}

model FileLo {
  fileLoId               String              @id @default(uuid()) @map("file_lo_id")
  pengirimanId           String              @map("pengiriman_id")
  produkId               String              @map("produk_id")
  jumlah                 Decimal             @map("jumlah") @db.Decimal(16, 6)
  satuanJumlah           String              @map("satuan_jumlah")
  noFaktur               String              @map("no_faktur")
  noLo                   String              @map("no_lo")
  namaDokumen            String              @map("nama_dokumen")
  namaFile               String              @map("nama_file")
  tanggalUpload          DateTime            @map("tanggal_upload")
  createdAt              DateTime            @map("created_at")
  updatedAt              DateTime            @map("updated_at")
  Pengiriman             Pengiriman          @relation(fields: [pengirimanId], references: [pengirimanId])
  Produk                 Produk              @relation(fields: [produkId], references: [produkId])
  FileLampiranLo         FileLampiranLo[]
  Penerimaan             Penerimaan[]
  DetailRencanaPembelian DetailRencanaFile[]
  Segel                  Segel[]

  @@map("file_lo")
}

model FilePembayaran {
  filePembayaranId String     @id @default(uuid()) @map("file_pembayaran_id")
  pembayaranId     String     @map("pembayaran_id")
  namaFile         String     @map("nama_file")
  namaDokumen      String     @map("nama_dokumen")
  tanggalUpload    DateTime   @map("tanggal_upload")
  createdAt        DateTime   @map("created_at")
  updatedAt        DateTime   @map("updated_at")
  Pembayaran       Pembayaran @relation(fields: [pembayaranId], references: [pembayaranId])

  @@map("file_pembayaran")
}

model FilePenarikan {
  filePenarikanId String    @id @default(uuid()) @map("file_penarikan_id")
  penarikanId     String    @map("penarikan_id")
  tanggal         DateTime  @map("tanggal")
  namaFile        String    @map("nama_file")
  namaDokumen     String    @map("nama_dokumen")
  keterangan      String?   @map("keterangan")
  createdAt       DateTime  @map("created_at")
  updatedAt       DateTime  @map("updated_at")
  Penarikan       Penarikan @relation(fields: [penarikanId], references: [penarikanId])

  @@map("file_penarikan")
}

model FilePenerimaan {
  filePenerimaanId String     @id @default(uuid()) @map("file_penerimaan_id")
  penerimaanId     String     @map("penerimaan_id")
  namaFile         String     @map("nama_file")
  namaDokumen      String     @map("nama_dokumen")
  tanggalUpload    DateTime   @map("tanggal_upload")
  Penerimaan       Penerimaan @relation(fields: [penerimaanId], references: [penerimaanId])

  @@map("file_penerimaan")
}

model FilePettyCash {
  filePettyCashId String    @id @default(uuid()) @map("file_petty_cash_id")
  pettyCashId     String    @map("petty_cash_id")
  namaFile        String    @map("nama_file")
  namaDokumen     String    @map("nama_dokumen")
  tanggalUpload   DateTime  @map("tanggal_upload")
  PettyCash       PettyCash @relation(fields: [pettyCashId], references: [pettyCashId])

  @@map("file_petty_cash")
}

model FilePost {
  filePostId  String   @id @default(uuid()) @map("file_post_id")
  postId      String   @map("post_id")
  namaFile    String   @map("nama_file")
  namaDokumen String   @map("nama_dokumen")
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")
  Post        Post     @relation(fields: [postId], references: [postId])

  @@map("file_post")
}

model FileStandMeter {
  fileStandMeterId String     @id @default(uuid()) @map("file_stand_meter_id")
  standMeterId     String     @map("stand_meter_id")
  namaFile         String     @map("nama_file")
  namaDokumen      String     @map("nama_dokumen")
  tanggalUpload    DateTime   @map("tanggal_upload")
  createdAt        DateTime   @map("created_at")
  updatedAt        DateTime   @map("updated_at")
  StandMeter       StandMeter @relation(fields: [standMeterId], references: [standMeterId])

  @@map("file_stand_meter")
}

model Gaji {
  gajiId         String       @id @default(uuid()) @map("gaji_id")
  jabatanId      String       @map("jabatan_id")
  tanggalBerlaku DateTime     @map("tanggal_berlaku")
  totalGaji      Decimal      @map("total_gaji") @db.Decimal(16, 6)
  potonganPajak  Decimal      @map("potongan_pajak") @db.Decimal(16, 6)
  keterangan     String?
  isAktif        Boolean      @map("is_aktif")
  createdAt      DateTime     @map("created_at")
  updatedAt      DateTime     @map("updated_at")
  Jabatan        Jabatan      @relation(fields: [jabatanId], references: [jabatanId])
  GajiMember     GajiMember[]

  @@map("gaji")
}

model GajiMember {
  gajiMemberId    String       @id @default(uuid()) @map("gaji_member_id")
  gajiId          String       @map("gaji_id")
  memberId        String       @map("member_id")
  tanggal         DateTime
  totalGajiBersih Decimal      @map("total_gaji_bersih") @db.Decimal(16, 6)
  Gaji            Gaji         @relation(fields: [gajiId], references: [gajiId])
  Member          Member       @relation(fields: [memberId], references: [memberId])
  DetailGaji      DetailGaji[]

  @@map("gaji_member")
}

model Harga {
  hargaId         String            @id @default(uuid()) @map("harga_id")
  produkId        String            @map("produk_id")
  jamKerjaId      String            @map("jam_kerja_id")
  tanggal         DateTime
  hargaJual       Decimal           @map("harga_jual") @db.Decimal(16, 6)
  hargaBeli       Decimal           @map("harga_beli") @db.Decimal(16, 6)
  isDefault       Boolean           @map("is_default")
  createdAt       DateTime          @map("created_at")
  updatedAt       DateTime          @map("updated_at")
  Produk          Produk            @relation(fields: [produkId], references: [produkId])
  JamKerja        JamKerja          @relation(fields: [jamKerjaId], references: [jamKerjaId])
  DetailPenjualan DetailPenjualan[]

  @@map("harga")
}

model Hari {
  hariId     String         @id @default(uuid()) @map("hari_id")
  namaHari   String         @map("nama_hari")
  hariKerja  Boolean        @map("hari_kerja")
  keterangan String?
  JamKerja   HariJamKerja[]

  @@map("hari")
}

model ImageSelfie {
  imageSelfieId String      @id @default(uuid()) @map("image_selfie_id")
  penjadwalanId String      @map("penjadwalan_id")
  namaFile      String      @map("nama_file")
  Penjadwalan   Penjadwalan @relation(fields: [penjadwalanId], references: [penjadwalanId])

  @@map("image_selfie")
}

model Jabatan {
  jabatanId            String                 @id @default(uuid()) @map("jabatan_id")
  levelId              String                 @map("level_id")
  namaJabatan          String                 @map("nama_jabatan")
  keterangan           String?
  isAktif              Boolean                @map("is_aktif")
  createdAt            DateTime               @map("created_at")
  updatedAt            DateTime               @map("updated_at")
  deletedAt            DateTime?              @map("deleted_at")
  Level                Level                  @relation(fields: [levelId], references: [levelId])
  Member               JabatanMember[]
  Gaji                 Gaji[]
  Penjadwalan          Penjadwalan[]
  PjOperasionalSetoran PjOperasionalSetoran[]

  @@map("jabatan")
}

model JamKerja {
  jamKerjaId                String                      @id @default(uuid()) @map("jam_kerja_id")
  spbuId                    String                      @map("spbu_id")
  namaJamKerja              String                      @map("nama_jam_kerja")
  batasAwalIn               DateTime                    @map("batas_awal_in")
  batasAkhirIn              DateTime                    @map("batas_akhir_in")
  jamDatangIn               DateTime                    @map("jam_datang_in")
  jamPulangOut              DateTime                    @map("jam_pulang_out")
  akhirOut                  DateTime                    @map("akhir_out")
  jamIstirahat              DateTime                    @map("jam_istirahat")
  masukIstirahat            DateTime                    @map("masuk_istirahat")
  batasTelat                DateTime                    @map("batas_telat")
  createdAt                 DateTime                    @map("created_at")
  updatedAt                 DateTime                    @map("updated_at")
  urutan                    Int
  Spbu                      Spbu                        @relation(fields: [spbuId], references: [spbuId])
  Hari                      HariJamKerja[]
  Harga                     Harga[]
  DetailRencanaPembelianMs2 DetailRencanaPembelianMs2[]
  DokumenStok               DokumenStok[]
  DombakTransfer            DombakTransfer[]
  Penjadwalan               Penjadwalan[]
  Penjualan                 Penjualan[]
  Presensi                  Presensi[]
  StandMeter                StandMeter[]

  @@map("jam_kerja")
}

model JenisLosses {
  jenisLossesId String   @id @default(uuid()) @map("jenis_losses_id")
  jenisLoss     String   @map("jenis_loss")
  deskripsi     String
  Losses        Losses[]

  @@map("jenis_losses")
}

model Kategori {
  kategoriId   String         @id @default(uuid()) @map("kategori_id")
  namaKategori String         @map("nama_kategori")
  detail       String
  Post         KategoriPost[]

  @@map("kategori")
}

model Konversi {
  konversiId         String                @id @default(uuid()) @map("konversi_id")
  satuanUkurTinggiId String                @map("satuan_ukur_tinggi_id")
  satuanUkurVolumeId String                @map("satuan_ukur_volume_id")
  dombakId           String                @map("dombak_id")
  tinggi             Decimal               @db.Decimal(16, 6)
